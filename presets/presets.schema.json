{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saycue.dev/schemas/preset.schema.json",
  "title": "SayCue preset",
  "description": "Deklaratywny preset komend (PLAN.md §5, architektura §2.5). Jeden katalog = jeden preset. Zero kodu: walidator odrzuca pliki .py oraz pola spoza schematu.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "kind", "platforms", "author", "license", "phrases", "commands"],
  "properties": {
    "id": {
      "description": "Identyfikator presetu = nazwa katalogu. Małe litery, cyfry, myślniki. Bez wersji w nazwie.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,48}$"
    },
    "version": {
      "description": "Wersja semver (MAJOR.MINOR.PATCH). Każda zmiana fraz = podbicie MINOR.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": { "type": "string", "minLength": 2, "maxLength": 64 },
    "kind": {
      "description": "Typ presetu (architektura §2.5: gry, OBS, aplikacje).",
      "type": "string",
      "enum": ["game", "obs", "apps"]
    },
    "platforms": {
      "description": "Platformy, na których preset ma sens. 'linux-wayland' tylko dla OBS/open-app.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["win", "linux-x11", "linux-wayland", "macos"] }
    },
    "game": {
      "description": "Dla kind=game: identyfikator gry używany w events.jsonl (preset_missing).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,40}$"
    },
    "author": {
      "description": "Autor wskazany w metadanych §2.5 (nazwa lub pseudonim).",
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "license": {
      "description": "Licencja pliku presetu. Domyślnie MIT — ta sama co rdzeń.",
      "type": "string",
      "enum": ["MIT"]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "obs": { "type": "boolean", "description": "Preset wymaga OBS ≥28 z obs-websocket v5." },
        "min_obs_version": { "type": "integer", "minimum": 28 },
        "plugins": { "type": "array", "items": { "type": "string" } }
      }
    },
    "apps": {
      "description": "Mapowanie nazw aplikacji używanych w slotach app.open/app.close (PL/EN → identyfikator systemowy).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "win", "linux"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,32}$" },
          "name": { "type": "string" },
          "win": { "type": "string", "description": "AUMID, nazwa exe albo 'shell:AppsFolder\\\\...'." },
          "linux": { "type": "string", "description": "Nazwa pliku .desktop albo komenda." },
          "url": { "type": "string", "description": "Jeśli aplikacja to strona w przeglądarce." },
          "aliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "scenes": {
      "description": "Sugerowane sceny OBS; użytkownik dopasowuje nazwy w GUI. '__next__'/'__prev__' = scena następna/poprzednia.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,32}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      }
    },
    "sources": {
      "description": "Sugerowane źródła OBS (mikrofon, audio pulpitu, alerty). Nazwy dopasowywane w GUI.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,32}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      }
    },
    "keys": {
      "description": "Domyślne bindy gry (odwołania do klawiszy z ustawień gry). Wartości: string[] (np. [l, shift+l]).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]{1,40}$": { "type": "array", "items": { "type": "string" } }
      }
    },
    "phrases": {
      "description": "Frazy presetu (≥5) — initial_prompt dla Whisper oraz rozpoznawane słowa nazw scen/aplikacji.",
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 2, "maxLength": 64 }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/command" }
    },
    "notes": { "type": "string", "maxLength": 1200 }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "intent", "phrases"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$",
          "description": "Identyfikator komendy w obrębie presetu (snake_case)."
        },
        "intent": {
          "type": "string",
          "enum": [
            "app.open",
            "app.close",
            "input.keys",
            "system.volume",
            "obs.scene",
            "obs.mute",
            "obs.record",
            "obs.replay",
            "obs.source_toggle",
            "window.focus"
          ]
        },
        "phrases": {
          "description": "3–6 wariantów: PL na początku, EN po nim. Bez interpunkcji i wielkich liter (parser normalizuje).",
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 2, "maxLength": 64 }
        },
        "slots": {
          "type": "object",
          "description": "Sloty intencji; dozwolone klucze zależą od intent (walidator: SLOT_RULES).",
          "additionalProperties": false,
          "properties": {
            "target": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,32}$" },
            "scene": { "type": "string", "minLength": 1, "maxLength": 48 },
            "source": { "type": "string", "minLength": 1, "maxLength": 48 },
            "state": { "type": "string", "enum": ["toggle", "on", "off"] },
            "keys": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "keybind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" },
            "direction": { "type": "string", "enum": ["up", "down"] },
            "step": { "type": "integer", "minimum": 1, "maximum": 30 },
            "action": { "type": "string", "enum": ["start", "stop", "toggle"] },
            "buffer": { "type": "string", "enum": ["save", "start", "stop"] }
          }
        },
        "risk": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "high = wymaga potwierdzenia głosem w rdzeniu (architektura §9); nie używać bez zgody."
        }
      }
    }
  }
}
